@model IEnumerable<API.Models.Category>
@{ ViewData["Title"] = "Categories (Lab 4)"; }
<h1>Categories</h1>
<div id="categories-live-status" class="alert alert-info py-2">
    Real-time updates are enabled for this list.
</div>
<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        (function () {
            const status = document.getElementById('categories-live-status');
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/categories')
                .withAutomaticReconnect()
                .build();

            connection.on('CategoriesChanged', function (message) {
                if (status) {
                    status.className = 'alert alert-success py-2';
                    status.textContent = message;
                }

                window.setTimeout(function () {
                    window.location.reload();
                }, 500);
            });

            connection.start().catch(function () {
                if (status) {
                    status.className = 'alert alert-warning py-2';
                    status.textContent = 'Real-time updates are unavailable right now.';
                }
            });
        })();
    </script>
}
