@model API.Models.TransactionDto

<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">
            @Model.Amount @Model.Currency?.Name
            <span class="badge bg-secondary float-end">@Model.Date.ToShortDateString()</span>
        </h5>
        <h6 class="card-subtitle mb-2 text-muted">@Model.Category?.Name</h6>
        <p class="card-text">@Model.Comment</p>
    </div>
</div>
