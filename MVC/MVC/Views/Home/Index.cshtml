@model API.Models.ViewModels.TransactionListViewModel

@{
    ViewData["Title"] = "Transactions";
}

<div class="row mb-3">
    <div class="col">
        <h2>Transactions @(Model.CurrentCategory != null ? $"- {Model.CurrentCategory}" : "")</h2>
    </div>
    <div class="col text-end">
        <a asp-controller="Draft" asp-action="Index" class="btn btn-primary">Create Draft Transaction</a>
    </div>
</div>

@if (!Model.Transactions.Any())
{
    <div class="alert alert-info">No transactions found.</div>
}
else
{
    @foreach (var t in Model.Transactions)
    {
        <partial name="_TransactionSummary" model="t" />
    }
}

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-category="@Model.CurrentCategory"
                       asp-route-productPage="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}

