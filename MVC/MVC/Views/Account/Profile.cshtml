@model MVC.Models.ViewModels.ProfileModel
@{
    ViewBag.Title = "Особистий кабінет";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Особистий кабінет</h2>
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="card">
            <div class="card-header">
                Профіль користувача
            </div>
            <div class="card-body">
                <form asp-action="Profile" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PhoneNumber" class="control-label">Номер телефону</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label class="control-label">Ролі</label>
                        <div>
                            @if (Model.Roles.Any())
                            {
                                foreach (var role in Model.Roles)
                                {
                                    <span class="badge bg-secondary">@role</span>
                                }
                            }
                            else
                            {
                                <span>Немає ролей</span>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-success">Зберегти зміни</button>
                        <a asp-action="Logout" class="btn btn-outline-danger float-end">Вийти</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
