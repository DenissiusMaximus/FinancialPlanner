@model API.Inputs.CreateTransactionInput

@{
    ViewData["Title"] = "Draft Transaction";
}

<h2>Create Transaction (Draft)</h2>
<p class="text-muted">Fill in the fields below. The data will be saved in the session if you navigate away.</p>

<form asp-action="SaveDraft" method="post">
    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Amount</label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-3">
        <label asp-for="Comment" class="form-label">Comment</label>
        <input asp-for="Comment" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Date" class="form-label">Date</label>
        <input asp-for="Date" class="form-control" type="date" />
    </div>
    <div class="mb-3">
        <label asp-for="SourceId" class="form-label">Source ID</label>
        <input asp-for="SourceId" class="form-control" type="number" />
    </div>
    <div class="mb-3">
        <label asp-for="CurrencyId" class="form-label">Currency ID</label>
        <input asp-for="CurrencyId" class="form-control" type="number" />
    </div>
    <div class="mb-3">
        <label asp-for="TransactionTypeId" class="form-label">Transaction Type ID</label>
        <input asp-for="TransactionTypeId" class="form-control" type="number" />
    </div>
    <button type="submit" class="btn btn-primary">Save to Session</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>

<form asp-action="ClearDraft" method="post" class="mt-3">
    <button type="submit" class="btn btn-outline-danger btn-sm">Clear Draft</button>
</form>

