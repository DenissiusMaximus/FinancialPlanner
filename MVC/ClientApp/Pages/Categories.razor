@page "/categories"
@using ClientApp.Models
@inject HttpClient Http
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<h3>Категорії (Categories)</h3>

@if (categories == null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ІД</th>
                <th>Назва</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in categories)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteCategory(category.Id)">Видалити</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Додати нову категорію</h4>
    <EditForm Model="newCategory" OnValidSubmit="AddCategory">
        <DataAnnotationsValidator />
        
        <div class="row align-items-center">
            <div class="col-8">
                <InputText @bind-Value="newCategory.Name" class="form-control" placeholder="Назва категорії" />
                <ValidationMessage For="@(() => newCategory.Name)" />
            </div>
            <div class="col-4">
                <button type="submit" class="btn btn-success">Додати</button>
            </div>
        </div>
    </EditForm>
}

@code {
    private List<CategoryDto>? categories;
    private CreateCategoryInput newCategory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/Category");
    }

    private async Task AddCategory()
    {
        var response = await Http.PostAsJsonAsync("api/Category", newCategory);
        if (response.IsSuccessStatusCode)
        {
            await LoadCategories();
            newCategory = new(); // скидаємо форму
        }
    }

    private async Task DeleteCategory(int id)
    {
        var response = await Http.DeleteAsync($"api/Category/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadCategories();
        }
    }
}
